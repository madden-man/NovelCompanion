{
  "name": "novel-companion",
  "version": "0.1.0",
  "description": "A desktop story bible and session brief companion for writing a novel.",
  "private": true,
  "type": "module",
  "main": "./out/main/index.js",
  "author": "Tommy Madden",
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.web.json --noEmit && tsc -p tsconfig.e2e.json --noEmit",
    "test": "npm run lint && npm run typecheck && npm run test:unit && npm run test:integration && npm run test:e2e",
    "test:unit": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "electron-vite build && playwright test",
    "test:live": "vitest run --project live",
    "fixtures:files": "node scripts/make-fixture-files.ts",
    "package": "electron-vite build && electron-builder --mac dmg",
    "import:eastwinds": "node scripts/import-eastwinds.ts"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.290",
    "@anthropic-ai/sdk": "0.133.0",
    "@napi-rs/keyring": "1.2.0",
    "mammoth": "1.11.0",
    "minisearch": "7.2.0",
    "mongodb": "6.21.0",
    "ulid": "3.0.2",
    "zod": "4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "5.2.0",
    "docx": "9.9.0",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "electron-vite": "5.0.0",
    "esbuild": "0.25.12",
    "eslint": "10.12.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-react-hooks": "7.1.1",
    "exceljs": "4.4.0",
    "globals": "17.13.0",
    "mongodb-memory-server": "10.4.3",
    "prettier": "3.9.10",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "4.1.11"
  }
}
